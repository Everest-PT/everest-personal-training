{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "python3 -m pip install -r requirements.txt -t .pydeps && PYTHONPATH=.pydeps python3 tools/build_blog.py && node tools/generate.js && rm -rf docs tools templates content .github .claude .pydeps README.md requirements.txt",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/coaching",
      "destination": "/personal-training/",
      "permanent": true
    },
    {
      "source": "/coaching/:path*",
      "destination": "/personal-training/",
      "permanent": true
    },
    {
      "source": "/performance",
      "destination": "/elite/",
      "permanent": true
    },
    {
      "source": "/performance/:path*",
      "destination": "/elite/",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/resources/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
